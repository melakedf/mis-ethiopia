generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum SubmissionKind {
  CONTACT
  DONATION
  NEWSLETTER
}

enum MediaType {
  IMAGE
  PDF
  FILE
}

enum UserRole {
  ADMIN
  EDITOR
}

model Program {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  shortDescription String
  fullDescription  String?
  category         String?
  gallery          Json          @default("[]")
  activities       Json          @default("[]")
  impactStory      String?
  goal             String?
  activeRegions    Json          @default("[]")
  impactNumber     String?
  featuredImage    String?
  icon             String?
  buttonText       String?       @default("Learn More")
  buttonLink       String?
  displayOrder     Int           @default(0)
  showOnHomepage   Boolean       @default(true)
  status           PublishStatus @default(PUBLISHED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Project {
  id           String        @id @default(cuid())
  label        String?
  title        String
  slug         String        @unique
  description  String
  location     String?
  image        String?
  stats        Json          @default("[]")
  keyOutcomes  Json          @default("[]")
  buttonText   String?       @default("Learn More")
  buttonLink   String?
  featured     Boolean       @default(false)
  displayOrder Int           @default(0)
  status       PublishStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Submission {
  id        String         @id @default(cuid())
  kind      SubmissionKind
  data      Json
  ip        String?
  userAgent String?
  createdAt DateTime       @default(now())
}

model Partner {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  logo           String?
  websiteUrl     String?
  category       String?
  description    String?
  tier           String?
  displayOrder   Int           @default(0)
  showOnHomepage Boolean       @default(true)
  status         PublishStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Report {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  year             Int
  reportType       String
  shortDescription String
  fileUrl          String?
  image            String?
  fileSize         String?
  buttonText       String?       @default("View / Download")
  displayOrder     Int           @default(0)
  showOnHomepage   Boolean       @default(false)
  status           PublishStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Story {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  category       String?
  shortStory     String
  quote          String?
  image          String?
  tags           Json          @default("[]")
  buttonText     String?
  buttonLink     String?
  showOnHomepage Boolean       @default(false)
  displayOrder   Int           @default(0)
  status         PublishStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Page {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  heroTitle      String?
  heroSubtitle   String?
  heroImage      String?
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  contentBlocks  Json          @default("[]")
  status         PublishStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Media {
  id         String    @id @default(cuid())
  fileName   String
  url        String
  type       MediaType
  provider   String?
  storageKey String?
  mimeType   String
  size       Int?
  altText    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
